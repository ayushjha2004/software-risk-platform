# Used by docker-compose.yml for variable substitution.
# Copy this file to `.env` at the project root before running
# `docker compose up --build`. Never commit the real `.env` file.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=risk_platform
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173

APP_NAME=AI Software Risk Platform API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

VITE_API_BASE_URL=http://localhost:8000/api/v1
