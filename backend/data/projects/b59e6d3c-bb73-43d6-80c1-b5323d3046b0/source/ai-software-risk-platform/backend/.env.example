# Copy this file to `.env` and adjust values for your local environment.
# Never commit the real `.env` file.

APP_NAME=AI Software Risk Platform API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# SQLAlchemy connection string for PostgreSQL (uses the psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/risk_platform

API_PREFIX=/api/v1

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
